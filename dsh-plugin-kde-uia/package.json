{
  "name": "dsh-plugin-kde-uia",
  "version": "0.1.2",
  "description": "Give a DeepSeek Harness agent Windows-UI-Automation-style control of a Linux KDE Plasma desktop over AT-SPI2, KWin and X11 (Arch Linux first; works from a Windows DSH host through WSL or SSH).",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./lib/runtime.js": "./lib/runtime.js",
    "./lib/tools.js": "./lib/tools.js"
  },
  "files": [
    "lib/**/*.js",
    "python/**/*.py",
    "python/**/py.typed",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "SECURITY.md",
    "MAINTENANCE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "kde",
    "plasma",
    "arch-linux",
    "uia",
    "ui-automation",
    "at-spi",
    "atspi",
    "accessibility",
    "kwin",
    "wayland",
    "gui-automation",
    "wsl"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "vendor": "bash ../scripts/sync-python.sh",
    "vendor:check": "bash ../scripts/sync-python.sh --check",
    "setup:test": "node scripts/setup-dsh-test-env.mjs",
    "smoke:load": "node scripts/smoke-dsh-load.mjs",
    "check:ts": "node scripts/check-types.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.types.json",
    "publish:kit": "node scripts/make-publish-kit.mjs"
  }
}
